# Optional environment for runner scripts.
# Copy this to .env and fill in if you want runners to use these.

# For story prompt expansion (4-beat scene template). If unset, runners use a fixed template.
# ANTHROPIC_API_KEY=

# Override target ComfyUI host/port if needed (defaults to 127.0.0.1:8188)
# COMFY_HOST=127.0.0.1
# COMFY_PORT=8188
